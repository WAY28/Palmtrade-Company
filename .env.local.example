# ============================================================
# PALMTRADE - Environment Variables
# ============================================================
# CARA PAKAI:
# 1. Rename file ini menjadi ".env.local"
# 2. Isi semua nilai di bawah dengan data dari Supabase kamu
# 3. Nilai ini bisa dilihat di: Supabase Dashboard > Settings > API
# ============================================================

# URL project Supabase kamu
# Contoh: https://abcdefghijklmn.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon/Public Key (aman untuk dipakai di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (RAHASIA! Jangan di-share. Hanya untuk server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
